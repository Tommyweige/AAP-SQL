# Vertex AI configuration for research generation.
# Authenticate locally with: gcloud auth application-default login
GOOGLE_VERTEX_PROJECT=replace-with-your-project-id
GOOGLE_VERTEX_LOCATION=global
# Model, generated relation graph, and experiment output paths.
AAP_GEMINI_MODEL_NAME=models/gemini-2.5-flash-lite
AAP_AUGMENTED_FK_PATH=outputs/research/thesis/undeclared_relations.json
AAP_REPRODUCTION_RESULTS_CSV=outputs/research/thesis-aligned-gemini-2.5/results.csv
